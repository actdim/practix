<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ActDim.Observability</RootNamespace>
    <AssemblyName>ActDim.Observability</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>ActDim.Observability</PackageId>
    <Description>OpenTelemetry-centric observability and ambient telemetry context framework for .NET applications.</Description>
    <PackageTags>actdim;observability;opentelemetry;logging;tracing;telemetry</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActDim.Practix.Abstractions\ActDim.Practix.Abstractions.csproj" />
    <ProjectReference Include="..\ActDim.Practix.Common\ActDim.Practix.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

</Project>
