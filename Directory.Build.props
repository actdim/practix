<Project>

	<PropertyGroup>
		<!-- Common Package Metadata -->
		<Authors>ActDim</Authors>
		<Company>ActDim</Company>
		<Product>ActDim Practix</Product>
		<Version>1.0.16</Version>

		<!-- Licensing & Repository -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/actdim/practix</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- Debug & Symbol Packaging -->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- Documentation File Generation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<NoWarn>$(NoWarn);1591;8002</NoWarn>

		<!-- Strong Naming & Public Signing -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)ActDim.pub</AssemblyOriginatorKeyFile>
		<PublicSign>true</PublicSign>
		<ActDimPublicKey></ActDimPublicKey>
	</PropertyGroup>

</Project>
