<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<IsPackable>true</IsPackable>
		<PackageId>ActDim.BytePath.SqliteRegistry</PackageId>
		<Description>SQLite metadata registry implementation for ActDim.BytePath with distributed locking, TTL expiration, and WAL mode support.</Description>
		<PackageTags>actdim;bytepath;blob;storage;payload;sqlite;locking;registry</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ActDim.BytePath\ActDim.BytePath.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
	</ItemGroup>

</Project>
