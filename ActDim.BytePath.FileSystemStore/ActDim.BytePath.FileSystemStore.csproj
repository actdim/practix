<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<IsPackable>true</IsPackable>
		<PackageId>ActDim.BytePath.FileSystemStore</PackageId>
		<Description>File-system blob data store implementation for ActDim.BytePath with sharded directory hashing.</Description>
		<PackageTags>actdim;bytepath;blob;storage;payload;filesystem</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ActDim.BytePath\ActDim.BytePath.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.10" />
	</ItemGroup>

</Project>
