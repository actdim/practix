# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual private credentials.
# .env is ignored by git and will never be committed.
# ==============================================================================

# NuGet API Key for publishing packages to nuget.org
NUGET_API_KEY=your-nuget-api-key-here

# NuGet Package Source (Default: https://api.nuget.org/v3/index.json)
NUGET_SOURCE=https://api.nuget.org/v3/index.json
